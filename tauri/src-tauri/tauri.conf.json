{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "recurse",
  "version": "0.1.0",
  "identifier": "com.aayush.recurse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Recurse",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "copyright": "Copyright 2026 Aayush Khanna",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Recurse-Labs/recurse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY"
    }
  }
}
